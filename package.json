{
  "name": "levelcompiler",
  "productName": "Level-Compiler",
  "version": "0.1.0-beta.2",
  "description": "Stratigraphic Correlation Viewer and Compiler",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac --universal",
    "build": "electron-builder --win --mac"
  },
  "author": "ky",
  "license": "MIT",
  "dependencies": {
    "csv-parse": "^5.6.0",
    "csv-stringify": "^6.5.2",
    "electron-progressbar": "^2.2.1",
    "electron-prompt": "^1.7.0",
    "electron-updater": "^6.6.2",
    "jszip": "^3.10.1",
    "sharp": "^0.34.2"
  },
  "build": {
    "appId": "io.github.ky_apps.Level-Compiler",
    "publish": {
      "provider": "github",
      "owner": "keitaroyamada",
      "repo": "Level-Compiler"
    },
    "win": {
      "target": [
        "msi",
        "nsis"
      ],
      "icon": "./icon/levelcompiler.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "./icon/levelcompiler.png"
    },
    "linux": {
      "icon": "./icon/levelcompiler.png"
    },
    "extraResources": [
      "resources/"
    ]
  },
  "devDependencies": {
    "electron": "^36.3.1",
    "electron-builder": "^26.0.12",
    "electronmon": "^2.0.3"
  }
}
